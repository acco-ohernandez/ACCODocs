<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>LinkLibraryEditor</AssemblyName>
		<RootNamespace>LinkLibraryEditor</RootNamespace>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<!-- The node/document models are shared with the Revit add-in — they have no Revit
	     dependency. Linked, not copied, so the schema can never drift between the two. -->
	<ItemGroup>
		<Compile Include="..\ACCODocs\Logic\LinkLibrary\LinkLibraryModels.cs" Link="Shared\LinkLibraryModels.cs" />
	</ItemGroup>

</Project>
