<UserControl x:Class="ACCODocs.Forms.LinkLibrary_Pane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="320" d:DesignHeight="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- "New and updated" badge (spec section 7, Phase 7) -->
        <Style x:Key="NewBadgeStyle" TargetType="TextBlock">
            <Setter Property="Text" Value=" NEW"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One node row for every list/tree: title (bold for groups) + gray kind, no "()" on groups -->
        <Style x:Key="NodeTitleStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NodeKindStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NodeRowTemplate">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ToolTip>
                    <ToolTip Content="{Binding Description}"/>
                </StackPanel.ToolTip>
                <TextBlock Text="{Binding Title}" Style="{StaticResource NodeTitleStyle}"/>
                <TextBlock Text="{Binding Kind, StringFormat=' ({0})'}" Style="{StaticResource NodeKindStyle}"/>
                <TextBlock Style="{StaticResource NewBadgeStyle}"
                           Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Expansion state lives on the node (LibraryNode.IsExpanded) so re-renders
             don't collapse the trees -->
        <Style x:Key="NodeContainerStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <!-- Shared row for both hierarchical trees -->
        <HierarchicalDataTemplate x:Key="NodeTreeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <StackPanel.ToolTip>
                    <ToolTip Content="{Binding Description}"/>
                </StackPanel.ToolTip>
                <TextBlock Text="{Binding Title}" Style="{StaticResource NodeTitleStyle}"/>
                <TextBlock Text="{Binding Kind, StringFormat=' ({0})'}" Style="{StaticResource NodeKindStyle}"/>
                <TextBlock Style="{StaticResource NewBadgeStyle}"
                           Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="ACCO Link Library"
                       FontSize="16" FontWeight="SemiBold"/>
            <!-- Library state: revision + online/offline/cached (spec section 10, no dialogs) -->
            <TextBlock x:Name="TxtLibraryStatus"
                       FontSize="11"
                       Foreground="Gray"
                       Text="Loading library..."/>
        </StackPanel>

        <!-- Two tabs (spec section 7): Library (browse + search) and My Links (favorites/recents/own links) -->
        <TabControl Grid.Row="1" BorderThickness="0,1,0,0" Padding="0,6,0,0">

            <TabItem Header="Library">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search (Phase 3) + Pick Element (Phase 5, spec section 8) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                x:Name="BtnPickElement"
                                Content="Pick Element"
                                Padding="8,2" Margin="6,0,0,0"
                                ToolTip="Find links related to the selected element (or pick one)"
                                Click="BtnPickElement_Click"/>
                        <Grid>
                            <TextBox x:Name="TxtSearch"
                                     Padding="4,3"
                                     TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock Text="Search title, description, tags..."
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Grid>
                    </DockPanel>

                    <!-- Pick Element result banner (Phase 5): on zero matches, never show an
                         empty pane — show the extracted tags plus a suggest action (spec section 8). -->
                    <Border Grid.Row="1"
                            x:Name="PanelPickInfo"
                            Visibility="Collapsed"
                            BorderBrush="Gray" BorderThickness="0,0,0,1"
                            Padding="0,0,0,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="TxtPickTags"
                                       TextWrapping="Wrap"
                                       FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="BtnPickSuggest"
                                        Content="Suggest a link for this"
                                        Padding="8,2" Margin="0,0,6,0"
                                        Visibility="Collapsed"
                                        Click="BtnPickSuggest_Click"/>
                                <Button Content="Clear"
                                        Padding="8,2"
                                        Click="BtnPickClear_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Browse mode: library tree (Phase 2) -->
                    <TreeView Grid.Row="2"
                              x:Name="TreeLibrary"
                             Background="White" Foreground="Black"
                              BorderThickness="0"
                              MouseDoubleClick="TreeLibrary_MouseDoubleClick"
                              ItemTemplate="{StaticResource NodeTreeTemplate}"
                              ItemContainerStyle="{StaticResource NodeContainerStyle}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem Header="Copy link" Click="CtxCopy_Click"/>
                                <MenuItem Header="Add to favorites" Click="CtxAddFavorite_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- Find mode: flat ranked results while the search box has text -->
                    <ListBox Grid.Row="2"
                             x:Name="ListResults"
                             Background="White" Foreground="Black"
                             Visibility="Collapsed"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="ListResults_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem Header="Copy link" Click="CtxCopy_Click"/>
                                <MenuItem Header="Add to favorites" Click="CtxAddFavorite_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <StackPanel.ToolTip>
                                        <ToolTip Content="{Binding Node.Description}"/>
                                    </StackPanel.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Node.Title}"/>
                                        <TextBlock Text="{Binding Node.Kind, StringFormat=' ({0})'}"
                                                   Foreground="Gray" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource NewBadgeStyle}"
                                                   Visibility="{Binding Node.IsNew, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Foreground="Gray" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="My Links">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search across favorites, recents, and user links -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBox x:Name="TxtSearchMy"
                                 Padding="4,3"
                                 TextChanged="TxtSearchMy_TextChanged"/>
                        <TextBlock Text="Search my links, favorites, recents..."
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearchMy}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Find mode: flat ranked results while the search box has text -->
                    <ListBox Grid.Row="1"
                             x:Name="ListMyResults"
                             Background="White" Foreground="Black"
                             Visibility="Collapsed"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="ListMyResults_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem Header="Copy link" Click="CtxCopy_Click"/>
                                <MenuItem Header="Add to favorites" Click="CtxAddFavorite_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <StackPanel.ToolTip>
                                        <ToolTip Content="{Binding Node.Description}"/>
                                    </StackPanel.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Node.Title}"/>
                                        <TextBlock Text="{Binding Node.Kind, StringFormat=' ({0})'}"
                                                   Foreground="Gray" FontSize="10"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource NewBadgeStyle}"
                                                   Visibility="{Binding Node.IsNew, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" Foreground="Gray" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Browse mode -->
                    <Grid Grid.Row="1" x:Name="PanelMyBrowse">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Auto-populated sections first — this is what people actually use daily (spec section 7) -->
                    <TextBlock Grid.Row="0" Text="Favorites" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <ListBox Grid.Row="1"
                             x:Name="ListFavorites"
                             Background="White" Foreground="Black"
                             BorderThickness="0"
                             MaxHeight="150"
                             ItemTemplate="{StaticResource NodeRowTemplate}"
                             MouseDoubleClick="NodeList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem Header="Copy link" Click="CtxCopy_Click"/>
                                <MenuItem Header="Remove from favorites" Click="CtxRemoveFavorite_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="Recents" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <ListBox Grid.Row="3"
                             x:Name="ListRecents"
                             Background="White" Foreground="Black"
                             BorderThickness="0"
                             MaxHeight="150"
                             ItemTemplate="{StaticResource NodeRowTemplate}"
                             MouseDoubleClick="NodeList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem Header="Copy link" Click="CtxCopy_Click"/>
                                <MenuItem Header="Add to favorites" Click="CtxAddFavorite_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <DockPanel Grid.Row="4" Margin="0,8,0,2">
                        <!-- Manual add is a secondary button, not the headline (spec section 7).
                             Suggest a link routes contributions into the master where everyone
                             benefits, instead of dying in one person's AppData. -->
                        <Button DockPanel.Dock="Right"
                                Content="Add link..."
                                Padding="8,2"
                                Click="BtnAddLink_Click"/>
                        <Button DockPanel.Dock="Right"
                                Content="Suggest a link..."
                                Padding="8,2" Margin="0,0,6,0"
                                Click="BtnSuggestLink_Click"/>
                        <TextBlock Text="My Links" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TreeView Grid.Row="5"
                              x:Name="TreeMyLinks"
                             Background="White" Foreground="Black"
                              BorderThickness="0"
                              MouseDoubleClick="TreeMyLinks_MouseDoubleClick"
                              ItemTemplate="{StaticResource NodeTreeTemplate}"
                              ItemContainerStyle="{StaticResource NodeContainerStyle}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="CtxOpen_Click"/>
                                <MenuItem Header="Copy link" Click="CtxCopy_Click"/>
                                <MenuItem Header="Add to favorites" Click="CtxAddFavorite_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="CtxDeleteUserLink_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <!-- Backup / sharing: exports are valid user-library JSON files -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Export..." Padding="8,2" Margin="0,0,6,0"
                                ToolTip="Save favorites, recents, and My Links to a JSON file for backup or sharing"
                                Click="BtnExportLinks_Click"/>
                        <Button Content="Import..." Padding="8,2"
                                ToolTip="Load links from an exported JSON file — merge new items or replace everything"
                                Click="BtnImportLinks_Click"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Dev-only self-test: proves the modeless-pane -> ExternalEvent -> Revit API
             -> Dispatcher round-trip (Phase 0). Remove before port. -->
        <Expander Grid.Row="2" Header="Dev: ExternalEvent self-test" Margin="0,8,0,8">
            <StackPanel Margin="0,4,0,0">
                <Button x:Name="BtnRoundTrip"
                        Content="Run round-trip (read model via ExternalEvent)"
                        Padding="8,4" Margin="0,0,0,6"
                        Click="BtnRoundTrip_Click"/>
                <TextBox x:Name="TxtTestOutput"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="120" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Text="No round-trip run yet."/>
            </StackPanel>
        </Expander>

        <TextBlock Grid.Row="3"
                   x:Name="TxtConfigStatus"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="Gray"
                   Text="Config: not loaded"/>
    </Grid>
</UserControl>
