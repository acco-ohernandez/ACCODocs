<Window x:Class="ACCODocs.Forms.AddUserLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Link"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontSize="14"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Title" Margin="0,0,0,2"/>
        <TextBox Grid.Row="1" x:Name="TxtTitle" Padding="4,3" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Text="Location (URL, file, folder, network/Box path, or Revit command id)" Margin="0,0,0,2"/>
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Browse Folder..." Padding="8,2" Margin="6,0,0,0"
                    Click="BtnBrowseFolder_Click"/>
            <Button DockPanel.Dock="Right" Content="Browse File..." Padding="8,2" Margin="6,0,0,0"
                    Click="BtnBrowseFile_Click"/>
            <TextBox x:Name="TxtLocation" Padding="4,3" TextChanged="TxtLocation_TextChanged"
                     ToolTip="Examples: https://... | C:\folder or \\server\share | ID_SETTINGS_UNITS (built-in Revit command) | CustomCtrl_%... (add-in command)"/>
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbKind" Width="110" HorizontalAlignment="Left">
                <ComboBoxItem Content="url"/>
                <ComboBoxItem Content="file"/>
                <ComboBoxItem Content="folder"/>
                <ComboBoxItem Content="mailto"/>
                <ComboBoxItem Content="video"/>
                <ComboBoxItem Content="command"/>
            </ComboBox>
            <TextBlock x:Name="TxtDetected" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="11" Foreground="Gray" Text="(auto-detected from the location)"/>
        </DockPanel>

        <!-- Where the link is filed: My Links > Category > Sub-category.
             Pick an existing group or type a new name to create it. -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Category (optional — type to create)" Margin="0,0,0,2"/>
                <ComboBox x:Name="CmbCategory" IsEditable="True"
                          SelectionChanged="CmbCategory_SelectionChanged"
                          LostKeyboardFocus="CmbCategory_LostKeyboardFocus"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Sub-category (optional)" Margin="0,0,0,2"/>
                <ComboBox x:Name="CmbSubCategory" IsEditable="True"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="6" Text="Description (optional)" Margin="0,0,0,2"/>
        <TextBox Grid.Row="7" x:Name="TxtDescription" Padding="4,3" Margin="0,0,0,8"
                 AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="8" x:Name="LblTags" Text="Tags" Margin="0,0,0,2"/>
        <ItemsControl Grid.Row="9" x:Name="ListTags" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,2,10,2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="10" Text="Custom tags (comma-separated, optional)" Margin="0,0,0,2"/>
        <TextBox Grid.Row="11" x:Name="TxtCustomTags" Padding="4,3" Margin="0,0,0,8"/>

        <DockPanel Grid.Row="12" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Text="Help"
                       VerticalAlignment="Center"
                       Foreground="#0B6CCB"
                       TextDecorations="Underline"
                       Cursor="Hand"
                       ToolTip="What can I put in each field?"
                       MouseLeftButtonUp="HelpAddLink_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnAdd" Content="Add" Width="80" Margin="0,0,8,0" IsDefault="True" Click="BtnAdd_Click"/>
                <Button Content="Cancel" Width="80" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="13" x:Name="TxtValidation" Margin="0,8,0,0" FontSize="11"
                   Foreground="DarkRed" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Window>
