<Window x:Class="ACCODocs.Forms.SuggestLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suggest a Link"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"
                   Text="Suggestions go to the ConTech team, who add them to the shared library so everyone benefits."/>

        <TextBlock Grid.Row="1" Text="URL" Margin="0,0,0,2"/>
        <TextBox Grid.Row="2" x:Name="TxtUrl" Padding="4,3" Margin="0,0,0,8" Text="https://"/>

        <TextBlock Grid.Row="3" Text="Title" Margin="0,0,0,2"/>
        <TextBox Grid.Row="4" x:Name="TxtTitle" Padding="4,3" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" Text="Suggested category" Margin="0,0,0,2"/>
        <TextBox Grid.Row="6" x:Name="TxtCategory" Padding="4,3" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="7" Text="Why it's useful" Margin="0,0,0,2"/>
        <TextBox Grid.Row="8" x:Name="TxtWhy" Padding="4,3" Margin="0,0,0,12"
                 AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Open in Mail App" Padding="10,4" Margin="0,0,8,0" IsDefault="True" Click="BtnMail_Click"/>
            <Button Content="Copy to Clipboard" Padding="10,4" Margin="0,0,8,0" Click="BtnCopy_Click"/>
            <Button Content="Close" Padding="10,4" IsCancel="True"/>
        </StackPanel>

        <TextBlock Grid.Row="10" x:Name="TxtStatus" Margin="0,8,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
    </Grid>
</Window>
