<Window x:Class="ACCODocs.Forms.ImportLinksModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Links"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtSummary" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="How should this file be imported?"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="Gray"
                   Text="Merge adds only links, favorites, and recents you don't already have — nothing of yours changes. Replace discards ALL of your current favorites, recents, and links and uses the file's content instead (a backup of your current file is saved first)."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Merge (add new only)" Padding="10,4" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnMerge_Click"/>
            <Button x:Name="BtnReplace" Content="Replace all" Padding="10,4" Margin="0,0,8,0"
                    Click="BtnReplace_Click"/>
            <Button Content="Cancel" Padding="10,4" IsCancel="True"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="TxtReplaceWarning" Margin="0,8,0,0" FontSize="11"
                   Foreground="DarkRed" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Click 'Replace all' again to confirm — this overwrites your current favorites, recents, and links."/>
    </Grid>
</Window>
